APP_NAME = 'mini-RAG'
APP_VERSION = '0.1.0'
APP_DESCRIPTION = 'A mini Retrieval-Augmented Generation (RAG) API built with FastAPI'

FILE_TYPE=["text/plain","application/pdf"]
FILE_SIZE_LIMIT=10485760
FILE_CHUNK_SIZE=512000 

POSTGRES_USERNAME = "postgres"
POSTGRES_PASSWORD = "postgres_password"
POSTGRES_HOST = "pgvector"
POSTGRES_PORT = "5432"
POSTGRES_DB = "mini-rag"

#LLM Config
GENERATION_BACKEND = "gemini"
EMBEDDING_BACKEND = "gemini"

OPENAI_API_KEY =" "
OPENAI_API_URL = ""

COHERE_API_KEY = " "

GEMINI_API_KEY = " "

GENERATION_MODEL_ID = "gemini-3.1-flash-lite"
EMBEDDING_MODEL_ID = "gemini-embedding-2"

EMBEDDING_MODEL_SIZE = 1024

INPUT_DEFAULT_MAX_TOKENS = 1024
GENERATION_DEFAULT_MAX_TOKENS = 1024
GENERATION_DEFAULT_TEMPERATURE = 0.1

VECTOR_DB_BACKEND_LITERAL = ["QDrant", "PGVector"]
VECTOR_DB_BACKEND = "PGVector"
VECTOR_DB_PATH = "qdrant_db"
VECTOR_DB_DISTANCE_METRIC = "Cosine"
VECTOR_DB_INDEX_THRESHOLD = 40

DEFAULT_LANGUAGE = "ar"